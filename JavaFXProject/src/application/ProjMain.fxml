<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="480.0" prefWidth="680.0" style="-fx-background-color: #0d0d1a;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.ProjCon">

  <!-- Left accent bar -->
  <Rectangle fill="#c9a84c" height="480" layoutX="0" layoutY="0" width="6" />

  <!-- App title area -->
  <VBox layoutX="40" layoutY="50" spacing="4">
    <Label style="-fx-text-fill:#c9a84c; -fx-font-size:13; -fx-font-weight:bold; -fx-letter-spacing:4;" text="🏀 BASKETBALL" />
    <Label style="-fx-text-fill:#ffffff; -fx-font-size:28; -fx-font-weight:bold;" text="LEAGUE MANAGER" />
    <Label style="-fx-text-fill:#8888aa; -fx-font-size:13;" text="Administration Portal" />
  </VBox>

  <!-- Divider line -->
  <Rectangle fill="#2a2a44" height="1" layoutX="40" layoutY="155" width="260" />

  <!-- Login card -->
  <VBox layoutX="40" layoutY="175" prefWidth="270" spacing="16" style="-fx-background-color: #16162a; -fx-background-radius:12; -fx-padding:28;">

    <Label style="-fx-text-fill:#ffffff; -fx-font-size:16; -fx-font-weight:bold;" text="Sign in to your account" />

    <!-- Username -->
    <VBox spacing="6">
      <Label style="-fx-text-fill:#8888aa; -fx-font-size:10; -fx-font-weight:bold; -fx-letter-spacing:2;" text="USERNAME" />
      <TextField fx:id="user_name" promptText="Enter username" style="-fx-background-color:#0d0d1a;                  -fx-text-fill:#ffffff;                  -fx-prompt-text-fill:#55556a;                  -fx-border-color:#2a2a44;                  -fx-border-radius:6;                  -fx-background-radius:6;                  -fx-padding:10 14;                  -fx-font-size:13;" />
    </VBox>

    <!-- Password -->
    <VBox spacing="6">
      <Label style="-fx-text-fill:#8888aa; -fx-font-size:10; -fx-font-weight:bold; -fx-letter-spacing:2;" text="PASSWORD" />
      <PasswordField fx:id="password" promptText="Enter password" style="-fx-background-color:#0d0d1a;                  -fx-text-fill:#ffffff;                  -fx-prompt-text-fill:#55556a;                  -fx-border-color:#2a2a44;                  -fx-border-radius:6;                  -fx-background-radius:6;                  -fx-padding:10 14;                  -fx-font-size:13;" />
    </VBox>

    <!-- Error label (hidden by default) -->
    <Label fx:id="errorLabel" managed="false" style="-fx-text-fill:#e05555; -fx-font-size:11;" text="" visible="false" />

    <!-- Login button -->
    <Button fx:id="btn" prefWidth="Infinity" style="-fx-background-color:#c9a84c;                -fx-text-fill:#0d0d1a;                -fx-font-weight:bold;                -fx-font-size:13;                -fx-letter-spacing:2;                -fx-background-radius:6;                -fx-padding:11 0;                -fx-cursor:hand;" text="LOGIN" />

  </VBox>

  <!-- Decorative right panel -->
  <VBox alignment="CENTER" layoutX="380" layoutY="0" prefHeight="480" prefWidth="300" spacing="20" style="-fx-background-color:#13132a;">

    <!-- Big basketball emoji decoration -->
    <Label style="-fx-font-size:90;" text="🏀" />
    <Label style="-fx-text-fill:#c9a84c; -fx-font-size:22; -fx-font-weight:bold; -fx-letter-spacing:4;" text="NBA STATS" />
    <Label style="-fx-text-fill:#8888aa; -fx-font-size:13;" text="Track players, teams &amp; statistics" textAlignment="CENTER" wrapText="true" />

    <!-- Stat pills -->
    <HBox alignment="CENTER" spacing="10">
      <VBox alignment="CENTER" spacing="2" style="-fx-background-color:#1e1e38; -fx-background-radius:8; -fx-padding:10 18;">
        <Label style="-fx-text-fill:#8888aa; -fx-font-size:10;" text="Players" />
        <Label style="-fx-text-fill:#c9a84c; -fx-font-size:18; -fx-font-weight:bold;" text="55+" />
      </VBox>
      <VBox alignment="CENTER" spacing="2" style="-fx-background-color:#1e1e38; -fx-background-radius:8; -fx-padding:10 18;">
        <Label style="-fx-text-fill:#8888aa; -fx-font-size:10;" text="Teams" />
        <Label style="-fx-text-fill:#c9a84c; -fx-font-size:18; -fx-font-weight:bold;" text="16+" />
      </VBox>
    </HBox>
  </VBox>

</AnchorPane>
